<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the login session out of backups and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="LegaciesUserSession.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="LegaciesUserSession.xml" />
    </device-transfer>
</data-extraction-rules>
