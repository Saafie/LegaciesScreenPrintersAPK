# Copy to keystore.properties (git ignores it) and fill in your own values.
# Create the key once with:
#   keytool -genkeypair -v -keystore legacies-upload.jks -alias legacies-upload -keyalg RSA -keysize 2048 -validity 10000
storeFile=../../keys/legacies-upload.jks
storePassword=CHANGE_ME
keyAlias=legacies-upload
keyPassword=CHANGE_ME
